{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.php?path=$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php?path=$1"
        }
    ],
    "installCommand": "composer install --no-dev --prefer-dist",
    "buildCommand": "npm run build",
    "outputDirectory": "public"
}

